# HMAC secret used to sign the HttpOnly session cookie (generate a long random value).
AUTH_SECRET=
# Laravel API base URL (server-side only).
API_BASE_URL=
# Laravel API base URL used by the public kiosk (exposed to the browser).
NEXT_PUBLIC_API_BASE_URL=

# Reverb / WebSocket (public display)
NEXT_PUBLIC_REVERB_KEY=kiyu-app-key
NEXT_PUBLIC_REVERB_HOST=kiyu.test
NEXT_PUBLIC_REVERB_PORT=443
NEXT_PUBLIC_REVERB_SCHEME=https

# Public surfaces (kiosk, display, online booking). The API resolves the tenant
# from this slug; the kiosk token is the credential issued when the device is
# registered in the admin console.
NEXT_PUBLIC_TENANT_SLUG=
NEXT_PUBLIC_FACILITY_ID=
