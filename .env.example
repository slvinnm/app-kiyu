# Node ignores the Windows CA store. Point this at a PEM bundle when the API is
# served with a local certificate, otherwise TLS calls fail at startup.
NODE_EXTRA_CA_CERTS=

# HMAC secret used to sign the HttpOnly session cookie (generate a long random value).
AUTH_SECRET=
# Laravel API base URL (server-side only).
API_BASE_URL=
# Public origin of this app, used to validate the Origin header on mutating
# requests. Leave empty behind a proxy that rewrites Host; set it in production.
APP_ORIGIN=
# Laravel API base URL used by the public visit-tracking page (exposed to the
# browser). Kiosk and display call the same-origin device proxy instead.
NEXT_PUBLIC_API_BASE_URL=

# Tenant slug for tenant-scoped public endpoints (`POST /auth/register`). The
# backend resolves the tenant from this header, the request host, or a route
# parameter; this app is served from a single development host, so it must be
# configured. Never used as authorization — the API still verifies membership.
NEXT_PUBLIC_TENANT_SLUG=

# Reverb / WebSocket (public display)
NEXT_PUBLIC_REVERB_KEY=kiyu-app-key
NEXT_PUBLIC_REVERB_HOST=kiyu.test
NEXT_PUBLIC_REVERB_PORT=443
NEXT_PUBLIC_REVERB_SCHEME=https